NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=coloque-a-anon-key-aqui

# domínio do site público que pode consumir a API /api/products (use "*" em dev)
STOREFRONT_ORIGIN=*

# Chave SECRETA do Supabase (Project Settings > API Keys > secret / service_role).
# Só servidor: usada pelo webhook do Mercado Pago, rollback de /api/orders e
# cron de expiração. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Mercado Pago (Checkout Pro) ---
# Access Token da aplicação criada em mercadopago.com.br/developers > Suas
# integrações > Credenciais. Use o de TESTE primeiro, troque pelo de
# produção só depois de validar o fluxo inteiro.
MP_ACCESS_TOKEN=
# Chave secreta configurada em Mercado Pago > Webhooks — usada pra validar
# a assinatura de cada notificação recebida.
MP_WEBHOOK_SECRET=
# URL pública onde ESTE admin está publicado (sem barra no final) — usada
# pra montar o notification_url do webhook. Em dev local, o Mercado Pago
# não alcança localhost: precisa de um túnel (ex: ngrok) ou testar contra o
# admin já publicado.
ADMIN_URL=
# URL pública do site da loja (sem barra no final) — usada pra montar os
# back_urls (páginas /pedido/sucesso, /pedido/pendente, /pedido/falha).
STOREFRONT_URL=
# "enforce" (padrão) recusa webhook com x-signature inválida; "log" só registra e
# segue (o pagamento é sempre conferido na API do MP de qualquer jeito).
MP_WEBHOOK_SIGNATURE_MODE=enforce
# Validade do link de pagamento / reserva de estoque, em minutos (padrão 60).
MP_PAYMENT_WINDOW_MINUTES=60
# Segredo do Vercel Cron (/api/cron/expire-orders). Qualquer string aleatória longa.
CRON_SECRET=
